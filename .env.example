# ============================================================================
# 壹页简历 — 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase 配置
# 获取方式：Supabase Dashboard → Settings → API
# ----------------------------------------------------------------------------
# 项目 URL（前端与服务端共用）
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# 匿名公开 key（前端使用，浏览器暴露安全）
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# 服务端专属 key（严禁暴露到前端！仅 server/ 下使用，用于绕过 RLS 写入订单/会员）
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ----------------------------------------------------------------------------
# 管理后台管理员白名单（逗号分隔的邮箱，命中即拥有中后台管理权限）
# 零迁移方案：无需在 users 表增加 is_admin 字段，改此变量即可增删管理员。
# 注意：为安全起见，建议使用独立的管理员账号而非普通用户账号。
# ----------------------------------------------------------------------------
ADMIN_EMAILS="admin@example.com, ops@example.com"

# ----------------------------------------------------------------------------
# 支付网关
# PAYMENT_PROVIDER=mock    → 模拟支付（默认，无需真实商户即可端到端跑通）
# PAYMENT_PROVIDER=wechat  → 微信支付 APIv3 Native（需配置下方 WECHAT_* 变量）
# 两种模式共用同一套业务代码，切换后无需改动任何业务逻辑。
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"

# 微信支付商户配置（仅 PAYMENT_PROVIDER=wechat 时需要）
# 商户 API 私钥：可直接内联填入 WECHAT_PRIVATE_KEY，或将 PEM 文件路径写入 WECHAT_PRIVATE_KEY_PATH
WECHAT_APPID="wx_APPID"
WECHAT_MCHID="YOUR_MCH_ID"
WECHAT_SERIAL_NO="YOUR_CERT_SERIAL_NO"
WECHAT_PRIVATE_KEY_PATH="./certs/apiclient_key.pem"
# WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_API_V3_KEY="YOUR_32_CHAR_API_V3_KEY"
# 微信支付平台公钥：可内联填入 WECHAT_PLATFORM_PUBLIC_KEY，或将 PEM 文件路径写入 WECHAT_PLATFORM_PUBLIC_KEY_PATH
WECHAT_PLATFORM_PUBLIC_KEY_PATH="./certs/wechatpay_pub.pem"
# WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ----------------------------------------------------------------------------
# DeepSeek AI（AI 翻译功能）
# 获取方式：https://platform.deepseek.com/
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# ----------------------------------------------------------------------------
# APP_URL：应用对外访问地址（用于拼接收款回调 notify_url）
# ----------------------------------------------------------------------------
APP_URL="MY_APP_URL"
